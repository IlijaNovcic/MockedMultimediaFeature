{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug",
      "type": "shell",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        },
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"
        }
      },
      "command": "if not exist build (mkdir build && cmake -S . -B build -G \"Unix Makefiles\" -DCMAKE_BUILD_TYPE=Debug) && cmake --build build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Configure + Build MockedMultimediaFeature (Debug)"
    },
    {
      "label": "Run",
      "type": "shell",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        },
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"
        }
      },
      "command": "${workspaceFolder}\\build\\MockedMultimediaFeature.exe",
      "group": "test",
      "dependsOn": "Build Debug",
      "problemMatcher": [],
      "detail": "Run MockedMultimediaFeature.exe"
    }
  ]
}